{
    "root": true,
    "ignorePatterns": [
        "dist",
        "node_modules",
        ".turbo",
        "coverage"
    ],
    "overrides": [
        {
            "files": [
                "*.ts",
                "*.tsx"
            ],
            "parser": "@typescript-eslint/parser",
            "extends": [
                "eslint:recommended",
                "plugin:@typescript-eslint/recommended"
            ],
            "plugins": [
                "@typescript-eslint"
            ],
            "rules": {
                "@typescript-eslint/no-unused-vars": [
                    "warn",
                    {
                        "argsIgnorePattern": "^_"
                    }
                ],
                "@typescript-eslint/no-explicit-any": "warn",
                "@typescript-eslint/consistent-type-imports": "error"
            }
        }
    ]
}